---
import '../styles/global.css';
import { SITE, GITHUB_URL } from '../data/site';

interface Props {
  /** Page title; SITE.title is used when omitted. */
  title?: string;
}

const { title = SITE.title } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = SITE.url;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={SITE.description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#131417" />
    <meta name="generator" content={Astro.generator} />

    <!-- Favicon (PrintVault branding) -->
    <link rel="icon" type="image/png" href={`${base}/favicon.png`} sizes="64x64" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={SITE.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${base}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="PrintVault — your 3D model library, finally easy to browse." />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={SITE.description} />
    <meta name="twitter:image" content={`${base}/og.png`} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
