  Windows:
    '<rect x="3" y="3" width="8.4" height="8.4" rx="1.4"/><rect x="12.6" y="3" width="8.4" height="8.4" rx="1.4"/><rect x="3" y="12.6" width="8.4" height="8.4" rx="1.4"/><rect x="12.6" y="12.6" width="8.4" height="8.4" rx="1.4"/>',
  // Linux mark: Tux (Simple Icons, CC0)
  Linux:
    '<path d="M12.504 0c-.155 0-.315.008-.48.021-4.226.333-3.105 4.807-3.17 6.298-.076 1.092-.3 1.953-1.05 3.02-.885 1.051-2.127 2.75-2.716 4.521-.278.832-.41 1.684-.287 2.489a.424.424 0 00-.11.135c-.26.268-.45.6-.663.839-.199.199-.485.267-.797.4-.313.136-.658.269-.864.68-.09.189-.136.394-.132.602 0 .199.027.4.055.536.058.399.116.728.04.97-.249.68-.28 1.145-.106 1.484.174.334.535.47.94.601.81.2 1.91.135 2.774.6.926.466 1.866.67 2.616.47.526-.116.97-.464 1.208-.946.587-.003 1.23-.269 2.26-.334.699-.058 1.574.267 2.577.2.025.134.063.198.114.333l.003.003c.391.778 1.113 1.132 1.884 1.071.771-.06 1.592-.536 2.257-1.306.631-.765 1.683-1.084 2.378-1.503.348-.199.629-.469.649-.853.023-.4-.2-.811-.714-1.376v-.097l-.003-.003c-.17-.2-.25-.535-.338-.926-.085-.401-.182-.786-.492-1.046h-.003c-.059-.054-.123-.067-.188-.135a.357.357 0 00-.19-.064c.431-1.278.264-2.55-.173-3.694-.533-1.41-1.465-2.638-2.175-3.483-.796-1.005-1.576-1.957-1.56-3.368.026-2.152.236-6.133-3.544-6.139z"/>',
};
---

<section id="download">
  <div class="container">
    <div class="section-head">
      <h2>Download PrintVault</h2>
      <p>
        Free, and ready to run on all three desktop platforms. Installers are
        served directly from GitHub Releases.
      </p>
    </div>

    <div class="platforms">
      {
        PLATFORM_DOWNLOADS.map((platform) => (
          <div class="platform">
            <div class="os">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <Fragment set:html={platformIcons[platform.os]} />
              </svg>
              <div>
                <h3>{platform.os}</h3>
                <span class="arch">{platform.arch}</span>
              </div>
            </div>

            <div class="buttons">
              {
                platform.buttons.map((button) => {
                  const cls = button.primary ? 'btn primary' : 'btn small';
                  return (
                    <a class={cls} href={button.href} rel="noopener">
                      {button.label}
                      <span class="detail">{button.detail}</span>
                    </a>
                  );
                })
              }
            </div>
          </div>
        ))
      }
    </div>

    <p class="releases-note">
      Looking for a different format? All {RELEASE.version} packages are on the
      <a href={RELEASES_PAGE_URL} rel="noopener">GitHub Releases page</a>.
    </p>
  </div>
</section>

<style>
  #download {
    background: var(--bg-raised);
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .platforms {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    max-width: 980px;
    margin: 0 auto;
  }

  .platform {
    display: flex;
    flex-direction: column;
    gap: 22px;
    background: var(--bg-panel);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius);
    padding: 26px;
  }

  .os {
    display: flex;
    align-items: center;
    gap: 13px;
  }

  .os svg {
    width: 30px;
    height: 30px;
    color: var(--text);
    flex: none;
  }

  .os h3 {
    font-size: 1.1rem;
  }

  .arch {
    color: var(--text-3);
    font-size: 0.84rem;
    font-family: var(--font-mono);
  }

  .buttons {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 10px;
  }

  /* Label stacked over the format detail, so buttons never overflow. */
  .buttons .btn {
    flex-direction: column;
    gap: 4px;
    white-space: normal;
    text-align: center;
    padding: 11px 16px;
  }

  .buttons .btn.primary {
    padding: 13px 16px;
  }

  .buttons .btn.small {
    background: transparent;
    border-color: var(--border-subtle);
  }

  .buttons .btn.small:hover {
    border-color: var(--border);
  }

  .detail {
    color: var(--text-3);
    font-size: 0.78rem;
    font-weight: 500;
    font-family: var(--font-mono);
  }

  .btn.primary .detail {
    color: rgba(255, 255, 255, 0.78);
  }

  .releases-note {
    text-align: center;
    color: var(--text-3);
    font-size: 0.9rem;
    margin: 40px 0 0;
  }

  .releases-note a {
    color: var(--text-2);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .releases-note a:hover {
    color: var(--text);
  }

  @media (max-width: 900px) {
    .platforms {
      grid-template-columns: 1fr;
      max-width: 460px;
    }
  }
</style>
