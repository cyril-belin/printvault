---
import { GITHUB_URL, RELEASE } from '../data/site';

const base = import.meta.env.BASE_URL;
---

<section class="hero">
  <div class="container">
    <div class="intro">
      <p class="eyebrow fade-up">STL &amp; 3MF library viewer for desktop</p>
      <h1 class="fade-up fade-up-1">Your 3D model library, finally easy to&nbsp;browse.</h1>
      <p class="sub fade-up fade-up-1">
        Browse, preview and manage your STL and 3MF files without opening a
        slicer. PrintVault runs locally on macOS, Windows and Linux.
      </p>
      <div class="ctas fade-up fade-up-2">
        <a class="btn primary large" href={`${import.meta.env.BASE_URL}/#download`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="7 10 12 15 17 10" />
            <line x1="12" y1="15" x2="12" y2="3" />
          </svg>
          Download PrintVault
        </a>
        <a class="btn large" href={GITHUB_URL} rel="noopener">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"></path>
          </svg>
          View on GitHub
        </a>
      </div>
      <p class="meta fade-up fade-up-2">
        Version {RELEASE.version} · Apple Silicon · Windows x64 · Linux x64
      </p>
    </div>

    <div class="stage fade-up fade-up-3">
      <div class="glow" aria-hidden="true"></div>
      <img
        class="shot"
        src={`${base}/screenshots/hero.webp`}
        alt="The PrintVault window: the library tree on the left, a phone-stand STL previewed in the 3D viewer, with size, dimensions and triangle count in the info bar below."
        width="2160"
        height="1350"
        fetchpriority="high"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 96px 0 104px;
    overflow: hidden;
  }

  .intro {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }

  .sub {
    color: var(--text-2);
    font-size: 1.18rem;
    line-height: 1.6;
    max-width: 620px;
    margin: 22px auto 0;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin-top: 34px;
  }

  .meta {
    color: var(--text-3);
    font-size: 0.86rem;
    margin: 22px 0 0;
    font-family: var(--font-mono);
    letter-spacing: -0.01em;
  }

  .stage {
    position: relative;
    max-width: 1080px;
    margin: 72px auto 0;
  }

  .glow {
    position: absolute;
    inset: -8% -6%;
    background: radial-gradient(
      48% 55% at 50% 42%,
      rgba(76, 141, 255, 0.16),
      transparent 70%
    );
    pointer-events: none;
  }

  .stage img {
    position: relative;
    width: 100%;
  }

  @media (max-width: 720px) {
    .hero {
      padding: 64px 0 72px;
    }

    .stage {
      margin-top: 52px;
    }
  }
</style>
