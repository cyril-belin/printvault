---
const features = [
  {
    title: 'Visual library',
    description:
      'Browse your actual filesystem with folders, search and a visual gallery.',
    icon: 'folder',
  },
  {
    title: 'STL + 3MF',
    description:
      'Preview binary STL, ASCII STL, and 3MF files, including multi-object 3MF assemblies.',
    icon: 'cube',
  },
  {
    title: 'Automatic thumbnails',
    description: 'Recognize models instantly without opening each file.',
    icon: 'image',
  },
  {
    title: 'Interactive viewer',
    description:
      'Orbit, zoom, inspect dimensions and rotate models directly on the grid.',
    icon: 'orbit',
  },
  {
    title: 'File management',
    description:
      'Rename, delete to Trash/Recycle Bin, and reveal files in the native file manager.',
    icon: 'file',
  },
  {
    title: 'Local-first',
    description: 'Your model library stays on your computer.',
    icon: 'shield',
  },
] as const;

// 24×24 stroke icons (Lucide-style, ISC).
const icons: Record<string, string> = {
  folder:
    '<path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/>',
  cube:
    '<path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/>',
  image:
    '<rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>',
  orbit:
    '<circle cx="12" cy="12" r="3"/><circle cx="19" cy="5" r="2"/><circle cx="5" cy="19" r="2"/><path d="M10.4 21.9a10 10 0 0 0 9.941-15.416"/><path d="M13.5 2.1a10 10 0 0 0-9.841 15.416"/>',
  file:
    '<path d="M12.5 22H18a2 2 0 0 0 2-2V7l-5-5H6a2 2 0 0 0-2 2v9.5"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M13.378 15.626a1 1 0 1 0-3.004-3.004l-5.01 5.012a2 2 0 0 0-.706 1.257l-.327 3.259a.5.5 0 0 0 .62.619l3.26-.327a2 2 0 0 0 1.256-.706z"/>',
  shield:
    '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>',
};
---

<section id="features">
  <div class="container">
    <div class="section-head">
      <h2>Built for real model libraries</h2>
      <p>
        PrintVault indexes the folders you already have — it never copies,
        moves or modifies your files.
      </p>
    </div>

    <ul class="grid">
      {
        features.map((feature) => (
          <li class="card">
            <div class="icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={icons[feature.icon]}
              />
            </div>
            <h3>{feature.title}</h3>
            <p>{feature.description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .card {
    background: var(--bg-raised);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius);
    padding: 26px 26px 28px;
    transition: border-color 0.15s ease;
  }

  .card:hover {
    border-color: var(--border);
  }

  .icon {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    background: rgba(76, 141, 255, 0.12);
    color: var(--accent);
    margin-bottom: 18px;
  }

  .icon svg {
    width: 21px;
    height: 21px;
  }

  .card h3 {
    margin-bottom: 8px;
  }

  .card p {
    margin: 0;
    color: var(--text-2);
    font-size: 0.94rem;
    line-height: 1.55;
  }

  @media (max-width: 960px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 620px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
